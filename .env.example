# Salin menjadi .env lalu isi. Semua opsional: aplikasi tetap jalan tanpa AI (mode heuristik offline).

# Pilih: anthropic | openai   ("openai" = semua API kompatibel OpenAI, termasuk Ollama/LM Studio/vLLM)
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Privasi: kirim 5 baris contoh ke AI? (false = hanya skema + statistik ringkas)
AI_SEND_SAMPLE=true

# Batas ukuran unggahan (MB)
MAX_UPLOAD_MB=100
